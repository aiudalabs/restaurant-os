# customer_web build-time config. Copy to .env.local to enable payments.
# Payments are OFF unless BOTH are set (the demo works without them).

# Public URL of the deployed FastAPI BFF (payments live here).
VITE_BFF_URL=https://api.tu-dominio.com

# Turn on the prepayment gate (PagueloFácil hosted checkout before the kitchen).
VITE_PAYMENTS_ENABLED=true
# Google Wallet (issue #77): 1 cuando el proyecto tenga su emisor configurado (functions/.env.<proyecto> + secreto GOOGLE_WALLET_KEY)
VITE_GOOGLE_WALLET=0
