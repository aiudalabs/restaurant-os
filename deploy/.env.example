# ─────────────────────────────────────────────────────────────────────────────
# RestaurantOS — deployment config. Copy to deploy/.env and fill in.
# NEVER commit deploy/.env (it holds secrets). Only this .example is committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── GCP / provisioning (used by install.sh + setup-gcp-backups.sh) ────────────
GCP_PROJECT=restaurant-os-68c79
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
VM_NAME=restaurantos-odoo
VM_MACHINE_TYPE=e2-medium          # 2 vCPU / 4 GB (~$24/mo). e2-standard-2 for more RAM.
VM_DISK_GB=30
BACKUP_BUCKET=restaurant-os-backups   # must be globally unique; created if missing
BACKUP_RETENTION_DAYS=30

# Domains (must point an A record to the VM's static IP before TLS works)
ODOO_DOMAIN=erp.tu-dominio.com
BFF_DOMAIN=api.tu-dominio.com
# Public web app the BFF redirects the customer back to after paying
CUSTOMER_APP_URL=https://restaurant-os-pedir.web.app
# Email for Let's Encrypt (Caddy)
ACME_EMAIL=admin@tu-dominio.com

# ── Postgres (runs in the all-in-one box; or point to Cloud SQL) ──────────────
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=restaurantes

# ── Odoo ──────────────────────────────────────────────────────────────────────
ODOO_VERSION=17
ODOO_MASTER_PASSWORD=CHANGE_ME_strong_master_password   # DB manager password

# ── BFF: Odoo connection ──────────────────────────────────────────────────────
ODOO_URL=http://odoo:8069
ODOO_DB=restaurantes
ODOO_USER=admin
ODOO_PASSWORD=CHANGE_ME_odoo_admin_password

# ── BFF: Firebase (service account JSON mounted into the container) ────────────
FIREBASE_PROJECT_ID=restaurant-os-68c79
FIREBASE_RTDB_URL=https://restaurant-os-68c79-default-rtdb.firebaseio.com
# Path on the VM to the service account key (do NOT commit it to git)
FIREBASE_SA_KEY_PATH=/opt/restaurantos/secrets/serviceAccountKey.json

# ── PagueloFácil (payments) ───────────────────────────────────────────────────
PAGUELOFACIL_ENV=sandbox                 # sandbox | production
PAGUELOFACIL_CCLW=                       # merchant web key (from PagueloFácil)
# Go-live hardening: server-to-server verification of the unsigned callback.
# Leave blank in sandbox. Confirm the REST status URL in PagueloFácil's docs.
PAGUELOFACIL_ACCESS_TOKEN=
PAGUELOFACIL_VERIFY_URL=

SECRET_KEY=CHANGE_ME_random_secret
