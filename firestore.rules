rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ─── Helper functions ───────────────────────────────────────────

    function uid() { return request.auth.uid; }
    function isAuthed() { return request.auth != null; }

    // hasUserDoc: true only if the caller has a users/{uid} document
    // (anonymous clients do not). Guards calls to userDoc().
    function hasUserDoc() {
      return isAuthed()
        && exists(/databases/$(db)/documents/users/$(uid()));
    }

    function userDoc() {
      return get(/databases/$(db)/documents/users/$(uid())).data;
    }
    function myOrgId() { return userDoc().orgId; }
    function myRole() { return userDoc().role; }

    function isAdmin() { return hasUserDoc() && myRole() == 'admin'; }
    function isManager() { return hasUserDoc() && myRole() in ['admin', 'manager']; }
    function isOperator() { return hasUserDoc() && myRole() in ['admin', 'manager', 'operator']; }
    function belongsToMyOrg(orgId) { return hasUserDoc() && myOrgId() == orgId; }
    // Anonymous customers (QR) have no users doc and may order anywhere; staff
    // may only create orders/items inside their own org.
    function canCreateInOrg(orgId) { return isAuthed() && (!hasUserDoc() || belongsToMyOrg(orgId)); }

    // ─── Organizations ──────────────────────────────────────────────

    // Org doc: public-ish settings of the tenant, readable by its staff.
    // Credentials (Odoo, Digifact, …) live in organizations/{orgId}/private/*,
    // which NO client can read or write (Admin SDK only).
    match /organizations/{orgId} {
      allow read: if belongsToMyOrg(orgId);
      allow write: if isAdmin() && belongsToMyOrg(orgId);

      match /private/{doc} {
        allow read, write: if false;
      }
    }

    // ─── Branches ───────────────────────────────────────────────────

    match /branches/{branchId} {
      allow read: if isAuthed();
      allow create: if isAdmin() && belongsToMyOrg(request.resource.data.orgId);
      allow update, delete: if isAdmin() && belongsToMyOrg(resource.data.orgId);
    }

    // ─── Menus ──────────────────────────────────────────────────────

    match /menus/{menuId} {
      allow read: if isAuthed();
      allow create: if isManager() && belongsToMyOrg(request.resource.data.orgId);
      allow update, delete: if isManager() && belongsToMyOrg(resource.data.orgId);
    }

    // ─── Categories ─────────────────────────────────────────────────

    match /categories/{categoryId} {
      allow read: if isAuthed();
      allow create: if isManager() && belongsToMyOrg(request.resource.data.orgId);
      allow update, delete: if isManager() && belongsToMyOrg(resource.data.orgId);
    }

    // ─── Products ───────────────────────────────────────────────────

    match /products/{productId} {
      allow read: if isAuthed();
      allow create: if isManager() && belongsToMyOrg(request.resource.data.orgId);
      allow update, delete: if isManager() && belongsToMyOrg(resource.data.orgId);
    }

    // ─── Tables ─────────────────────────────────────────────────────

    match /tables/{tableId} {
      allow read: if belongsToMyOrg(resource.data.orgId);
      allow create: if isManager() && belongsToMyOrg(request.resource.data.orgId);
      allow update, delete: if isManager() && belongsToMyOrg(resource.data.orgId);
    }

    // ─── Stations ───────────────────────────────────────────────────

    match /stations/{stationId} {
      allow read: if isAuthed() && belongsToMyOrg(resource.data.orgId);
      allow create: if isAdmin() && belongsToMyOrg(request.resource.data.orgId);
      allow update, delete: if isAdmin() && belongsToMyOrg(resource.data.orgId);
    }

    // ─── Orders ─────────────────────────────────────────────────────
    // A customer reads ONLY the orders they created (createdByUid).
    // Staff read orders from their own org (no cross-tenant leak).
    //
    // Clients only ever CREATE orders in an initial state; totals are
    // recomputed by onOrderCreated and payment/fiscal fields are written by
    // Cloud Functions / the BFF only (recordPayment, confirmManualPayment,
    // onOrderPaid). Staff may update the kitchen lifecycle and a few labels.

    function newPaymentOk(d) {
      let ps = d.get('payment', {}).get('status', null);
      return ps == null || ps == 'pending';
    }
    function validNewOrder() {
      let d = request.resource.data;
      return d.createdByUid == uid()
        && d.orgId is string && d.branchId is string
        && d.status in ['pending', 'pending_payment']
        && d.get('source', '') in ['qr', 'waiter']
        && !('fiscal' in d)
        && !('invoiceRequest' in d && d.invoiceRequest is map && d.invoiceRequest.get('receiverType', '02') == '01' && d.invoiceRequest.get('taxId', '') == '')
        && newPaymentOk(d);
    }
    function staffOrderUpdate() {
      let d = request.resource.data;
      return d.orgId == resource.data.orgId
        && d.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt', 'completedAt', 'notes', 'customerName', 'tableNumber', 'invoiceRequest'])
        && (d.status == resource.data.status
            || d.status in ['confirmed', 'in_preparation', 'ready', 'delivered', 'closed', 'cancelled']);
    }

    match /orders/{orderId} {
      allow create: if canCreateInOrg(request.resource.data.orgId) && validNewOrder();
      allow read: if belongsToMyOrg(resource.data.orgId)
                  || resource.data.createdByUid == uid();
      allow update: if belongsToMyOrg(resource.data.orgId)
                    && (isManager() || myRole() == 'waiter')
                    && staffOrderUpdate();
    }

    // ─── Order Items ────────────────────────────────────────────────
    // Same scoping as orders. KDS operators update items of their station.
    // New items are always 'queued' and unrouted; onOrderCreated assigns the
    // station and the real prices.

    function validNewItem() {
      let d = request.resource.data;
      return d.createdByUid == uid()
        && d.orgId is string && d.orderId is string
        && d.productId is string && d.productId.size() > 0
        && d.status == 'queued'
        && d.get('stationId', '') == '';
    }

    match /order_items/{itemId} {
      allow create: if canCreateInOrg(request.resource.data.orgId) && validNewItem();
      allow read: if belongsToMyOrg(resource.data.orgId)
                  || resource.data.createdByUid == uid();
      allow update: if belongsToMyOrg(resource.data.orgId)
                    && (isManager()
                        || userDoc().stationId == resource.data.stationId
                        || counterUpdate());
    }

    // Counter mode (issue #45): an item whose category has no active station is
    // left unrouted by onOrderCreated; the waiter prepares it and marks it
    // in_progress/done. Only unrouted items, only status fields.
    function counterUpdate() {
      return myRole() == 'waiter'
        && resource.data.get('stationId', '') == ''
        && request.resource.data.status in ['in_progress', 'done']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'startedAt', 'completedAt', 'updatedAt']);
    }

    // ─── Users ──────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if uid() == userId
                  || (isManager() && belongsToMyOrg(resource.data.orgId));
      allow create: if isAdmin() && belongsToMyOrg(request.resource.data.orgId);
      allow update, delete: if isAdmin() && belongsToMyOrg(resource.data.orgId);
    }

    // ─── Integrations ───────────────────────────────────────────────
    // NEVER accessible from clients. Only Cloud Functions (Admin SDK).

    match /integrations/{integrationId} {
      allow read, write: if false;
    }

    // ─── KDS PINs ───────────────────────────────────────────────────
    // Hashed station PINs — server-only (set via setStationPin, verified via
    // kdsLogin). No client can read the hash or write a PIN.

    match /kds_pins/{stationId} {
      allow read, write: if false;
    }

    // ─── Waiter PINs ────────────────────────────────────────────────
    // Hashed personal PINs of waiters — server-only (set via setWaiterPin,
    // verified via waiterLogin). Same shape and lockout as kds_pins.

    match /staff_pins/{userId} {
      allow read, write: if false;
    }

    // ─── Club (loyalty, issue #75) ──────────────────────────────────
    // Written only by Cloud Functions (onOrderPaid, redeemReward, useVoucher).
    // A customer reads only their own member doc, ledger events and vouchers.

    match /loyalty_members/{id} {
      allow read: if isAuthed() && resource.data.uid == uid();
      allow write: if false;
    }
    match /loyalty_events/{id} {
      allow read: if isAuthed() && resource.data.uid == uid();
      allow write: if false;
    }
    match /loyalty_vouchers/{id} {
      allow read: if isAuthed() && resource.data.uid == uid();
      allow write: if false;
    }

    // ─── Audit Log ──────────────────────────────────────────────────
    // Read-only for managers. Writes only from Cloud Functions.

    match /audit_log/{logId} {
      allow read: if isManager() && belongsToMyOrg(resource.data.orgId);
      allow write: if false;
    }
  }
}
